+// NIST SP 800-56 Concatenation KDF with SHA-256 (what geth's concatKDF does)
+static int concat_kdf_sha256(const uint8_t* Z, size_t Z_len, uint8_t* out, size_t out_len) {
     uint32_t counter = 1;
     size_t generated = 0;
-    unsigned char hash[SHA256_DIGEST_LENGTH];
-
     while (generated < out_len) {
-        SHA256_CTX ctx;
-        SHA256_Init(&ctx);
-        unsigned char ctr[4] = {
-            (unsigned char)((counter >> 24) & 0xff),
-            (unsigned char)((counter >> 16) & 0xff),
-            (unsigned char)((counter >>  8) & 0xff),
-            (unsigned char)( counter        & 0xff)
