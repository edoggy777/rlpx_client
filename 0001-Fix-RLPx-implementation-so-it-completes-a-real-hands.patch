--- a/src/keccak.c
+++ b/src/keccak.c
@@ -1,107 +1,113 @@
 // src/keccak.c
-// Minimal Keccak-256 implementation for RLPx
-// Based on the Keccak reference implementation
+// Keccak-256 (the original pre-SHA3 padding used by Ethereum) with an
+// incremental API, because RLPx frame MACs are running keccak states.
 
 #include "keccak.h"
 #include <string.h>
 #include <stdint.h>
 
 #define KECCAK_ROUNDS 24
+#define KECCAK_RATE   136   // 1600 - 2*256 bits = 136 bytes
 
-// Keccak round constants
-static const uint64_t keccak_round_constants[KECCAK_ROUNDS] = {
+static const uint64_t RC[KECCAK_ROUNDS] = {
     0x0000000000000001ULL, 0x0000000000008082ULL, 0x800000000000808aULL,
     0x8000000080008000ULL, 0x000000000000808bULL, 0x0000000080000001ULL,
     0x8000000080008081ULL, 0x8000000000008009ULL, 0x000000000000008aULL,
-    0x0000000000000088ULL, 0x0000000080008009ULL, 0x8000000000008003ULL,
-    0x8000000000008002ULL, 0x8000000000000080ULL, 0x000000000000800aULL,
-    0x800000008000000aULL, 0x8000000080008081ULL, 0x8000000000008080ULL,
-    0x0000000080000001ULL, 0x8000000080008008ULL, 0x0000000000008082ULL,
-    0x8000000000008003ULL, 0x8000000080008080ULL, 0x8000000080000001ULL
+    0x0000000000000088ULL, 0x0000000080008009ULL, 0x000000008000000aULL,
+    0x000000008000808bULL, 0x800000000000008bULL, 0x8000000000008089ULL,
+    0x8000000000008003ULL, 0x8000000000008002ULL, 0x8000000000000080ULL,
+    0x000000000000800aULL, 0x800000008000000aULL, 0x8000000080008081ULL,
+    0x8000000000008080ULL, 0x0000000080000001ULL, 0x8000000080008008ULL
 };
 
-// Rotation offsets
-static const unsigned int keccak_rho_offsets[25] = {
-     0,  1, 62, 28, 27, 36, 44,  6, 55, 20,  3, 10, 43, 25, 39, 41, 45, 15,
-    21,  8, 18,  2, 61, 56, 14
+// Rotation offsets indexed by x + 5*y
+static const unsigned int RHO[25] = {
+     0,  1, 62, 28, 27,
+    36, 44,  6, 55, 20,
+     3, 10, 43, 25, 39,
+    41, 45, 15, 21,  8,
+    18,  2, 61, 56, 14
 };
 
-// Left rotation
 static inline uint64_t rotl64(uint64_t x, unsigned int n) {
-    return (x << n) | (x >> (64 - n));
+    return n == 0 ? x : (x << n) | (x >> (64 - n));
 }
 
-// Keccak-f[1600] permutation
-static void keccak_f1600(uint64_t state[25]) {
+static void keccak_f1600(uint64_t A[25]) {
     uint64_t C[5], D[5], B[25];
-    
+
     for (int round = 0; round < KECCAK_ROUNDS; round++) {
-        // Theta step
-        for (int x = 0; x < 5; x++) {
-            C[x] = state[x] ^ state[x + 5] ^ state[x + 10] ^ state[x + 15] ^ state[x + 20];
-        }
-        
-        for (int x = 0; x < 5; x++) {
+        // Theta
+        for (int x = 0; x < 5; x++)
+            C[x] = A[x] ^ A[x + 5] ^ A[x + 10] ^ A[x + 15] ^ A[x + 20];
+        for (int x = 0; x < 5; x++)
             D[x] = C[(x + 4) % 5] ^ rotl64(C[(x + 1) % 5], 1);
-        }
-        
-        for (int x = 0; x < 5; x++) {
-            for (int y = 0; y < 5; y++) {
-                state[y * 5 + x] ^= D[x];
-            }
-        }
-        
-        // Rho and Pi steps
-        for (int x = 0; x < 5; x++) {
-            for (int y = 0; y < 5; y++) {
-                B[y * 5 + ((2 * x + 3 * y) % 5)] = rotl64(state[y * 5 + x], keccak_rho_offsets[y * 5 + x]);
-            }
-        }
-        
-        // Chi step
-        for (int x = 0; x < 5; x++) {
-            for (int y = 0; y < 5; y++) {
-                state[y * 5 + x] = B[y * 5 + x] ^ ((~B[y * 5 + ((x + 1) % 5)]) & B[y * 5 + ((x + 2) % 5)]);
-            }
-        }
-        
-        // Iota step
-        state[0] ^= keccak_round_constants[round];
+        for (int i = 0; i < 25; i++)
+            A[i] ^= D[i % 5];
+
+        // Rho + Pi:  B[y, 2x+3y] = rot(A[x, y], r[x, y])
+        // (previous version had x/y swapped in the destination index)
+        for (int x = 0; x < 5; x++)
+            for (int y = 0; y < 5; y++)
+                B[y + 5 * ((2 * x + 3 * y) % 5)] = rotl64(A[x + 5 * y], RHO[x + 5 * y]);
+
+        // Chi
+        for (int y = 0; y < 5; y++)
+            for (int x = 0; x < 5; x++)
+                A[x + 5 * y] = B[x + 5 * y] ^ ((~B[(x + 1) % 5 + 5 * y]) & B[(x + 2) % 5 + 5 * y]);
+
+        // Iota
+        A[0] ^= RC[round];
     }
 }
 
-// Main Keccak-256 function
-void keccak256(const uint8_t* input, size_t len, uint8_t output[32]) {
-    uint64_t state[25] = {0};
-    uint8_t* state_bytes = (uint8_t*)state;
-    
-    const size_t rate = 136; // 1600 - 2*256 = 1088 bits = 136 bytes
-    size_t offset = 0;
-    
-    // Absorbing phase
-    while (len >= rate) {
-        for (size_t i = 0; i < rate; i++) {
-            state_bytes[i] ^= input[offset + i];
+static void absorb_block(keccak_ctx_t* ctx, const uint8_t* block) {
+    // little-endian lane loading, works on any host endianness
+    for (size_t i = 0; i < KECCAK_RATE / 8; i++) {
+        uint64_t lane = 0;
+        for (int b = 7; b >= 0; b--) lane = (lane << 8) | block[i * 8 + b];
+        ctx->state[i] ^= lane;
+    }
+    keccak_f1600(ctx->state);
+}
+
+void keccak_init(keccak_ctx_t* ctx) {
+    memset(ctx, 0, sizeof(*ctx));
+}
+
+void keccak_update(keccak_ctx_t* ctx, const uint8_t* data, size_t len) {
+    while (len > 0) {
+        size_t space = KECCAK_RATE - ctx->buf_len;
+        size_t take = len < space ? len : space;
+        memcpy(ctx->buf + ctx->buf_len, data, take);
+        ctx->buf_len += take;
+        data += take;
+        len -= take;
+        if (ctx->buf_len == KECCAK_RATE) {
+            absorb_block(ctx, ctx->buf);
