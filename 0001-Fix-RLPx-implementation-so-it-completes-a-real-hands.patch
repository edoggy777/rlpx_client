+        printf("<- %s (id 0x%02x, %zu bytes)\n", what, id, len);
+        hex_dump(buf, len > 64 ? 64 : len, "   ");
+        if (len > 64) printf("   ...\n");
+        if (id == 0x02) {
+            uint8_t empty = 0xc0;
+            rlpx_send_message(conn, 0x03, &empty, 1);
+            printf("-> Pong\n");
+        }
+        if (id == 0x01) return;
+    }
