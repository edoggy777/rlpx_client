+static int parse_hex(const char* hex, uint8_t* out, size_t cap) {
+    if (strncmp(hex, "0x", 2) == 0) hex += 2;
+    size_t n = strlen(hex);
+    if (n % 2 || n / 2 > cap) return -1;
+    for (size_t i = 0; i < n / 2; i++) {
+        unsigned v;
+        if (sscanf(hex + 2 * i, "%2x", &v) != 1) return -1;
+        out[i] = (uint8_t)v;
+    }
+    return (int)(n / 2);
